/* ============================================================
   MainMenu.uss — Styles riêng cho Main Menu screen.
   Theme Đại Nam: bàn trà cổ, con dấu, hộp sơn mài.
   ============================================================ */

/* ─── Background ─── */
.main-menu-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg-dark);
    /* Thay bằng background-image khi có art asset:
       background-image: url("project://..."); */
}

/* ─── Content ─── */
.main-menu-content {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

/* ─── Header ─── */
.main-menu-header {
    align-items: center;
    margin-bottom: 20px;
}

.game-title {
    font-size: 64px;
    color: var(--color-gold-bright);
    -unity-font-style: bold;
    letter-spacing: 8px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(120, 85, 40, 0.6);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    margin-bottom: 4px;
}

.game-subtitle {
    font-size: 18px;
    color: var(--color-gold-dim);
    letter-spacing: 4px;
}

/* ─── Player Info Bar ─── */
.player-info-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 420px;
    padding: 10px 20px;
    margin-bottom: 32px;
    background-color: var(--color-bg-panel);
    border-width: 1px;
    border-color: var(--color-border-light);
    border-radius: var(--border-radius-md);
}

.player-name {
    font-size: 18px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.player-stats {
    flex-direction: row;
    align-items: center;
}

.player-level {
    font-size: 14px;
    color: var(--color-gold);
    margin-right: 16px;
}

.player-gold {
    font-size: 14px;
    color: var(--color-gold-bright);
    -unity-font-style: bold;
}

/* ─── Menu Buttons Container ─── */
.menu-buttons-container {
    align-items: center;
    width: 360px;
}

/* ─── Menu Button (base) ─── */
.menu-btn {
    width: 100%;
    padding: 14px 32px;
    margin-bottom: 12px;
    border-radius: var(--border-radius-lg);
    border-width: 2px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, scale, color;
    transition-duration: 0.2s;
}

.menu-btn:hover {
    scale: 1.04;
}

.menu-btn:active {
    scale: 0.96;
}

/* ─── Primary: Chiến Đấu (con dấu đỏ son) ─── */
.menu-btn-primary {
    background-color: var(--color-red);
    border-color: rgb(200, 75, 60);
    color: rgb(255, 240, 220);
    font-size: 24px;
    padding: 18px 32px;
    margin-bottom: 20px;
}

.menu-btn-primary:hover {
    background-color: var(--color-red-hover);
    border-color: var(--color-gold);
}

.menu-btn-primary:active {
    background-color: rgb(140, 40, 30);
}

/* ─── Secondary: Shop, Inventory (hộp sơn mài) ─── */
.menu-btn-secondary {
    background-color: var(--color-bg-medium);
    border-color: var(--color-border);
    color: var(--color-text-primary);
}

.menu-btn-secondary:hover {
    background-color: rgb(65, 48, 32);
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
}

.menu-btn-secondary:active {
    background-color: rgb(38, 25, 16);
}

/* ─── Tertiary: Settings (nhỏ, mờ hơn) ─── */
.menu-btn-tertiary {
    background-color: transparent;
    border-color: var(--color-border-light);
    border-width: 1px;
    color: var(--color-text-secondary);
    font-size: 16px;
    padding: 10px 24px;
    width: 60%;
    margin-top: 8px;
}

.menu-btn-tertiary:hover {
    background-color: rgba(50, 35, 25, 0.6);
    border-color: var(--color-gold-dim);
    color: var(--color-text-primary);
}

/* ─── Footer ─── */
.main-menu-footer {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    align-items: center;
}

.version-label {
    font-size: 12px;
    color: var(--color-text-dim);
    opacity: 0.6;
}
