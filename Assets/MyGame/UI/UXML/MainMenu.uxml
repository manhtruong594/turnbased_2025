<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MyGame/UI/USS/Common.uss?fileID=7433441132597879392&amp;guid=0b80053ade238cb499f5793804f7c098&amp;type=3#Common" />
    <Style src="project://database/Assets/MyGame/UI/USS/MainMenu.uss?fileID=7433441132597879392&amp;guid=5f32496a95a0e3245b3742091d718a3c&amp;type=3#MainMenu" />
    <ui:VisualElement name="main-menu-root" class="screen-root">
        <ui:VisualElement name="background" class="main-menu-bg" />
        <ui:VisualElement name="content" class="main-menu-content" style="width: auto; height: auto; bottom: 2px; right: 2px; min-width: auto; min-height: auto; max-width: none; max-height: none; top: -1px;">
            <ui:VisualElement name="header" class="main-menu-header" style="justify-content: center; align-items: center; align-self: stretch; align-content: flex-start; translate: 0 -94px; transform-origin: top;">
                <ui:Label name="game-title" text="ĐẠI NAM" class="game-title" />
                <ui:Label name="game-subtitle" text="Chiến Thuật Cổ Lệnh" class="game-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement name="player-info" class="player-info-bar" style="height: auto; width: 474px; translate: 0 -64px;">
                <ui:Label name="player-name" text="Summoner" class="player-name" />
                <ui:VisualElement name="player-stats" class="player-stats">
                    <ui:Label name="player-level" text="Lv. 1" class="player-level" />
                    <ui:Label name="player-gold" text="💰 100" class="player-gold" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="menu-buttons" class="menu-buttons-container" style="translate: 0 -29px; justify-content: flex-end;">
                <ui:Button name="btn-battle" text="⚔ Chiến Đấu" class="menu-btn menu-btn-primary" />
                <ui:Button name="btn-shop" text="🏪 Cửa Hàng" class="menu-btn menu-btn-secondary" style="-unity-text-align: middle-center;" />
                <ui:Button name="btn-inventory" text="📜 Bộ Sưu Tập" class="menu-btn menu-btn-secondary" />
                <ui:Button name="btn-settings" text="⚙ Cài Đặt" class="menu-btn menu-btn-tertiary" />
            </ui:VisualElement>
            <ui:VisualElement name="footer" class="main-menu-footer">
                <ui:Label name="version-label" text="v0.1 — Vertical Slice" class="version-label" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
