<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MyGame/UI/USS/Common.uss?fileID=7433441132597879392&amp;guid=0b80053ade238cb499f5793804f7c098&amp;type=3#Common" />
    <Style src="project://database/Assets/MyGame/UI/USS/PrepareBattle.uss?fileID=7433441132597879392&amp;guid=ca15502c1d3592142a71793ab41195bd&amp;type=3#PrepareBattle" />
    <ui:VisualElement name="prepare-root" class="screen-root">
        <ui:VisualElement name="header" class="prepare-header">
            <ui:Button name="btn-back" text="← Quay Lại" class="btn prepare-btn-back" />
            <ui:Label name="screen-title" text="Chuẩn Bị Chiến Đấu" class="prepare-title" />
            <ui:VisualElement name="gold-display" class="prepare-gold">
                <ui:Label name="gold-label" text="💰 100" class="player-gold" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="main-content" class="prepare-content">
            <ui:VisualElement name="collection-panel" class="panel prepare-collection">
                <ui:VisualElement name="tab-bar" class="prepare-tab-bar">
                    <ui:Button name="tab-units" text="⚔ Binh Lính" class="prepare-tab prepare-tab--active" />
                    <ui:Button name="tab-spells" text="✨ Phép Thuật" class="prepare-tab" />
                </ui:VisualElement>
                <ui:VisualElement name="filter-row" class="prepare-filter-row">
                    <ui:TextField name="search-field" class="prepare-search" />
                </ui:VisualElement>
                <ui:ScrollView name="collection-scroll" class="prepare-collection-scroll">
                    <ui:VisualElement name="collection-list" class="prepare-collection-list" />
                </ui:ScrollView>
                <ui:Label name="empty-label" text="Chưa có vật phẩm nào" class="prepare-empty-label" />
            </ui:VisualElement>
            <ui:VisualElement name="deck-panel" class="panel prepare-deck">
                <ui:ScrollView name="deck-scroll" class="prepare-deck-scroll">
                    <ui:VisualElement name="deck-section-units" class="prepare-deck-section">
                        <ui:Label name="deck-units-title" text="Đội Hình (0/6)" class="prepare-deck-title" />
                        <ui:VisualElement name="deck-units-grid" class="prepare-deck-grid" />
                    </ui:VisualElement>
                    <ui:VisualElement class="separator" />
                    <ui:VisualElement name="deck-section-spells" class="prepare-deck-section">
                        <ui:Label name="deck-spells-title" text="Phép (0/4)" class="prepare-deck-title" />
                        <ui:VisualElement name="deck-spells-grid" class="prepare-deck-grid" />
                    </ui:VisualElement>
                    <ui:VisualElement class="separator" />
                    <ui:VisualElement name="deck-info" class="prepare-deck-info">
                        <ui:Label text="Bản Đồ" class="prepare-deck-title" />
                        <ui:DropdownField name="map-dropdown" class="prepare-map-dropdown" />
                        <ui:Label name="map-description" class="prepare-map-description" />
                        <ui:Label text="Chế Độ Chơi" class="prepare-deck-title" />
                        <ui:VisualElement name="mode-selector" class="prepare-mode-selector">
                            <ui:Button name="btn-mode-ai" text="Đấu Với AI" class="prepare-mode-button prepare-mode-button--active" />
                            <ui:Button name="btn-mode-local-pvp" text="PvP Cùng Máy" class="prepare-mode-button" />
                        </ui:VisualElement>
                        <ui:Label name="mode-description" text="Đối đầu với máy." class="prepare-mode-description" />
                        <ui:Label name="total-cost-label" text="Tổng chi phí: 0" class="prepare-cost-label" />
                        <ui:Label name="validation-label" class="prepare-validation-label" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement name="action-buttons" class="prepare-actions">
                    <ui:Button name="btn-clear" text="Xóa Tất Cả" class="btn prepare-btn-clear" style="width: 100px; min-width: 100px; max-width: 100px;" />
                    <ui:VisualElement class="prepare-battle-actions">
                        <ui:Button name="btn-multiplayer" text="🌐 Multiplayer • Phòng riêng" class="btn prepare-btn-multiplayer" />
                        <ui:Button name="btn-confirm" text="⚔ Xác Nhận Chiến Đấu" class="btn prepare-btn-confirm" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="multiplayer-panel" class="multiplayer-overlay">
            <ui:VisualElement name="multiplayer-dialog" class="panel multiplayer-dialog">
                <ui:Label text="MULTIPLAYER • 1v1" class="multiplayer-title" />
                <ui:Label name="multiplayer-status" text="Tạo phòng hoặc nhập mã phòng để tham gia." class="multiplayer-status" />
                <ui:VisualElement name="multiplayer-lobby" class="multiplayer-lobby">
                    <ui:Label name="multiplayer-room" text="Dùng đội hình đã chọn ở màn hình chuẩn bị." class="multiplayer-room" />
                    <ui:Label name="multiplayer-players" class="multiplayer-players" />
                    <ui:TextField name="multiplayer-code" label="Mã phòng" max-length="16" class="multiplayer-code" />
                    <ui:VisualElement class="multiplayer-button-row">
                        <ui:Button name="multiplayer-create" text="Tạo Phòng" class="btn multiplayer-button" />
                        <ui:Button name="multiplayer-join" text="Tham Gia" class="btn multiplayer-button multiplayer-button--primary" />
                    </ui:VisualElement>
                    <ui:Button name="multiplayer-copy" text="Sao Chép Mã Phòng" class="btn multiplayer-button" />
                    <ui:Button name="multiplayer-ready" text="Sẵn Sàng" class="btn multiplayer-button" />
                    <ui:Button name="multiplayer-start" text="Bắt Đầu Trận" class="btn multiplayer-button multiplayer-button--primary" />
                </ui:VisualElement>
                <ui:Button name="multiplayer-leave" text="Đóng / Rời Phòng" class="btn multiplayer-button multiplayer-button--leave" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
