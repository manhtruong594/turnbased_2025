/* ============================================================
   SkillTest.uss — Minimalist & Native-like UI Toolkit Stylesheet
   Dành cho Developer / Tester Debug Bench trong SkillTestScene.
   ============================================================ */

.st-root {
    position: absolute;
    left: 12px;
    top: 12px;
    bottom: 12px;
    width: 360px;
    padding: 10px;
    background-color: rgba(18, 24, 34, 0.96);
    border-width: 1px;
    border-color: rgba(218, 185, 115, 0.25);
    border-radius: 8px;
    color: rgb(240, 242, 245);
    font-size: 12px;
    flex-direction: column;
}

.st-root--collapsed {
    bottom: auto;
    height: 48px;
    width: 280px;
}

/* ─── Header ─── */
.st-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.st-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(218, 185, 115);
    letter-spacing: 0.5px;
}

.st-header-actions {
    flex-direction: row;
    align-items: center;
}

.st-mini-btn {
    padding: 2px 6px;
    min-height: 20px;
    margin-left: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(220, 225, 235);
}

.st-mini-btn:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border-color: rgb(218, 185, 115);
}

.st-mini-btn--danger:hover {
    background-color: rgba(180, 50, 50, 0.5);
    border-color: rgb(240, 90, 90);
}

/* ─── Status Banner ─── */
.st-status-banner {
    margin-top: 6px;
    margin-bottom: 4px;
    padding: 6px 8px;
    border-radius: 4px;
    border-left-width: 3px;
    font-size: 11px;
    white-space: normal;
}

.st-status--info {
    background-color: rgba(30, 50, 80, 0.5);
    border-left-color: rgb(75, 150, 230);
    color: rgb(210, 230, 255);
}

.st-status--success {
    background-color: rgba(30, 70, 45, 0.5);
    border-left-color: rgb(65, 195, 110);
    color: rgb(200, 250, 220);
}

.st-status--warning {
    background-color: rgba(80, 65, 25, 0.5);
    border-left-color: rgb(235, 180, 55);
    color: rgb(255, 235, 180);
}

.st-status--error {
    background-color: rgba(85, 35, 35, 0.5);
    border-left-color: rgb(235, 75, 65);
    color: rgb(255, 205, 205);
}

/* ─── Tab Bar ─── */
.st-tab-bar {
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    padding: 2px;
}

.st-tab-btn {
    flex-grow: 1;
    min-height: 24px;
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 3px;
    background-color: transparent;
    color: rgb(160, 172, 190);
    margin: 0 1px;
}

.st-tab-btn:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(220, 230, 245);
}

.st-tab-btn--active {
    background-color: rgb(44, 93, 135);
    color: rgb(255, 255, 255);
}

/* ─── Scroll Container ─── */
.st-scroll {
    flex-grow: 1;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* ─── Section Card ─── */
.st-section {
    margin-bottom: 8px;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.st-section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(218, 185, 115);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

/* ─── Controls (Dropdown & Buttons) ─── */
.st-field {
    margin-bottom: 6px;
}

.st-field > .unity-base-field__label {
    min-width: 100px;
    font-size: 11px;
    color: rgb(185, 195, 210);
}

.st-field .unity-base-popup-field__input {
    min-height: 24px;
    font-size: 11px;
    background-color: rgba(25, 33, 46, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    color: rgb(240, 242, 245);
}

.st-btn {
    min-height: 26px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 4px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(35, 47, 66, 0.9);
    color: rgb(235, 240, 250);
    font-size: 11px;
    -unity-font-style: normal;
    white-space: normal;
}

.st-btn:hover {
    background-color: rgba(50, 70, 98, 0.95);
    border-color: rgb(75, 145, 220);
}

.st-btn:active {
    background-color: rgba(25, 36, 52, 1);
}

.st-btn--primary {
    background-color: rgb(44, 93, 135);
    border-color: rgb(70, 135, 195);
    -unity-font-style: bold;
}

.st-btn--primary:hover {
    background-color: rgb(55, 115, 165);
    border-color: rgb(110, 175, 235);
}

.st-btn-row {
    flex-direction: row;
    margin-top: 2px;
    margin-bottom: 2px;
}

.st-btn-row > .st-btn {
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 2px;
}

/* ─── Bars (HP & MP) ─── */
.st-bar-container {
    margin-bottom: 6px;
}

.st-bar-label-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
    font-size: 10px;
    color: rgb(180, 190, 205);
}

.st-progress-bar {
    height: 14px;
    margin: 0;
}

.st-progress-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 3px;
    border-width: 0;
}

.st-progress-bar .unity-progress-bar__progress {
    border-radius: 3px;
}

.st-progress-bar .unity-progress-bar__title {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.st-hp-bar .unity-progress-bar__progress {
    background-color: rgb(185, 55, 55);
}

.st-mp-bar .unity-progress-bar__progress {
    background-color: rgb(45, 130, 205);
}

/* ─── Skill Cards ─── */
.st-skill-card {
    margin-bottom: 5px;
    padding: 6px 8px;
    background-color: rgba(28, 38, 54, 0.85);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.st-skill-card:hover {
    border-color: rgb(75, 145, 220);
    background-color: rgba(38, 52, 74, 0.95);
}

.st-skill-card--selected {
    border-color: rgb(240, 195, 80);
    background-color: rgba(45, 62, 88, 1);
}

.st-skill-card--cooldown {
    opacity: 0.6;
}

.st-skill-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3px;
}

.st-skill-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(245, 248, 252);
}

.st-badge-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.st-badge {
    padding: 1px 5px;
    margin-right: 4px;
    margin-bottom: 2px;
    border-radius: 3px;
    font-size: 9px;
    -unity-font-style: bold;
}

.st-badge--mp {
    background-color: rgba(45, 130, 205, 0.35);
    color: rgb(150, 215, 255);
    border-width: 1px;
    border-color: rgba(45, 130, 205, 0.6);
}

.st-badge--range {
    background-color: rgba(60, 160, 95, 0.3);
    color: rgb(170, 245, 195);
    border-width: 1px;
    border-color: rgba(60, 160, 95, 0.5);
}

.st-badge--target {
    background-color: rgba(130, 90, 180, 0.3);
    color: rgb(225, 200, 255);
    border-width: 1px;
    border-color: rgba(130, 90, 180, 0.5);
}

.st-badge--cd {
    background-color: rgba(200, 60, 60, 0.35);
    color: rgb(255, 185, 185);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.6);
}

.st-skill-hint {
    font-size: 10px;
    color: rgb(160, 175, 195);
    white-space: normal;
}

/* ─── Animation Rows ─── */
.st-anim-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 4px;
}

.st-anim-preview-btn {
    flex-grow: 1;
    min-height: 25px;
    margin-right: 3px;
    padding: 3px 8px;
    font-size: 11px;
    text-align: left;
    white-space: normal;
}

.st-anim-ping-btn {
    min-width: 44px;
    min-height: 25px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(218, 185, 115);
}

/* ─── Event Monitor ─── */
.st-event-box {
    height: 110px;
    background-color: rgba(10, 14, 20, 0.7);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin-top: 4px;
}

.st-event-item {
    font-size: 10px;
    color: rgb(180, 220, 255);
    margin-bottom: 2px;
}

/* ─── Footer ─── */
.st-footer {
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    flex-direction: row;
    justify-content: space-between;
    font-size: 10px;
    color: rgb(140, 150, 168);
}

